# Copy to .env.local (gitignored) for local dev. Never commit real values — see CLAUDE.md /
# architecture brief Part 4: secrets live in Supabase/Vercel secret stores in every deployed
# environment; this file only documents which variables exist.

# Supabase — from `supabase status` when running the local stack (see carebridge-roadmap.md).
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# WhatsApp Business Cloud API (packages/whatsapp) — Meta Business Manager verification is a
# Phase 0 parallel-track item (see CLAUDE.md), not blocked by the app phase gate.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# Payments — Paystack for GHS, Stripe for diaspora currencies (USD/GBP/EUR), Phase 1.
PAYSTACK_SECRET_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_APP_URL=

# KYC vendor for identity_verification (Domain 3) — vendor choice (Smile ID vs. Youverify) is
# still an open question in carebridge-roadmap.md; both are listed until that's settled.
SMILE_ID_API_KEY=
YOUVERIFY_API_KEY=
