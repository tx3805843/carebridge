node_modules/
.pnpm-store/

# build outputs
.next/
dist/
build/
.turbo/
.expo/
.expo-shared/

# env
.env
.env.local
.env.*.local

# supabase
supabase/.branches/
supabase/.temp/

# logs
*.log
npm-debug.log*
